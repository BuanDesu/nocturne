{
  "name": "nocturne",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5178",
    "typecheck": "tsc --noEmit",
    "build:static": "tsc --noEmit && vite build --config vite.config.static.ts",
    "preview:static": "vite preview --config vite.config.static.ts --port 5182 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Nocturne — a front-end craft demonstration in six movements. WebGL, kinetic typography and scroll choreography.",
  "author": "BuanDesu",
  "license": "MIT",
  "homepage": "https://buandesu.github.io/nocturne/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuanDesu/nocturne.git"
  }
}
